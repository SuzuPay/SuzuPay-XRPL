# Environment Variables for SuzuPay-XRPL
# Copy this file to .env.local and fill in your actual values

# XRPL Configuration
# Database Configuration
DATABASE_URL="postgresql://user:password@host:5432/database"
NEXT_PUBLIC_XRPL_NETWORK=mainnet
NEXT_PUBLIC_XRPL_WS_URL=wss://xrplcluster.com

# RLUSD Mainnet Issuer (Ripple official)
NEXT_PUBLIC_RLUSD_ISSUER=rMxCKbEDwqr76QuheSUMdEGf4B9xJ8m5De

# Wallet Connect Configuration
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Xaman API Configuration
NEXT_PUBLIC_XAMAN_API_KEY=your_xaman_api_key_here